{
  "name": "@platform/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "prisma:cli": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js",
    "generate": "export DATABASE_URL=\"${DATABASE_URL:-postgresql://synthetic_user:***@127.0.0.1:1/synthetic_db?connect_timeout=1}\"; pnpm run prisma:cli -- generate",
    "build": "export DATABASE_URL=\"${DATABASE_URL:-postgresql://synthetic_user:***@127.0.0.1:1/synthetic_db?connect_timeout=1}\"; pnpm run generate && tsc --project tsconfig.build.json && pnpm run export:openapi",
    "export:openapi": "export DATABASE_URL=\"${DATABASE_URL:-postgresql://synthetic_user:***@127.0.0.1:1/synthetic_db?connect_timeout=1}\"; node --env-file-if-exists=.env scripts/export-openapi.ts",
    "typecheck": "export DATABASE_URL=\"${DATABASE_URL:-postgresql://synthetic_user:***@127.0.0.1:1/synthetic_db?connect_timeout=1}\"; pnpm run generate && tsc --noEmit --project tsconfig.json",
    "lint": "eslint --config ../../packages/eslint-config/index.mjs --no-error-on-unmatched-pattern --ignore-pattern \"src/generated/prisma/**\" prisma.config.ts \"scripts/**/*.ts\" \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "pnpm run build && node --test test/*.spec.ts",
    "contract:check": "pnpm run build && node ../../scripts/check-contract.mjs",
    "db:dev": "pnpm run prisma:cli -- migrate dev",
    "db:migrate:dev": "pnpm run db:dev",
    "db:deploy": "pnpm run prisma:cli -- migrate deploy",
    "db:check": "pnpm run prisma:cli -- migrate status"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "nestjs-pino": "5.2.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@platform/eslint-config": "workspace:*",
    "@platform/tsconfig": "workspace:*",
    "@types/node": "24.10.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3"
  }
}
