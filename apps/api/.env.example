# Local development only — not for production.
NODE_ENV=development
PORT=3001
POSTGRES_USER=foundation_user
POSTGRES_PASSWORD=foundation_local_password_not_for_production
POSTGRES_DB=foundation_dev
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://foundation_user:foundation_local_password_not_for_production@localhost:5432/foundation_dev?schema=public
# Optional explicit browser-origin allowlist. Omit this value to keep CORS disabled (default-deny).
CORS_ORIGIN=http://localhost:3000
