{
  "name": "@platform/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-ts --file openapi-ts.config.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2024 --module ESNext --moduleResolution Bundler --strict --skipLibCheck false src/index.ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "6.0.3"
  }
}
